{
  "contract": "crewbus harness adapters",
  "version": 1,
  "status": "frozen-M0",
  "note": "UIs render resume unsupported when resume=false; never fake continuity. Mirrors bin/lib/spawn.js buildSpawnTarget + docs/COMPATIBILITY.md.",
  "drivers": [
    {
      "driver": "opencode",
      "displayName": "opencode",
      "binary": "opencode",
      "versionProbe": ["--version"],
      "briefDelivery": "file",
      "sessionCapture": "log",
      "sessionKeys": ["session.id", "session_id"],
      "resume": true,
      "capabilities": { "jsonLog": true, "preassign": false, "compactionHook": "verified", "autoModes": ["auto-approve"] },
      "permissionMap": { "supervised": "default prompts", "autoEdits": "not offered — supervised + note", "auto": "--auto (auto-approve non-denied)", "full": "--auto --i-understand-danger" },
      "spawnArgs": "run --file <brief> --format json",
      "resumeArgs": "run --session <id> --file <brief|catchup> --format json"
    },
    {
      "driver": "claude",
      "displayName": "Claude Code",
      "binary": "claude",
      "versionProbe": ["--version"],
      "briefDelivery": "stdin",
      "sessionCapture": "preassigned",
      "sessionKeys": ["session_id", "sessionId"],
      "resume": true,
      "capabilities": { "jsonLog": true, "preassign": true, "preassignFlag": "--session-id", "compactionHook": "verified", "autoModes": ["unattended -p"] },
      "permissionMap": { "supervised": "default prompts", "autoEdits": "acceptEdits middle ground where supported", "auto": "--auto equivalent unattended", "full": "--auto --i-understand-danger" },
      "spawnArgs": "-p --output-format json --session-id <uuid> < brief",
      "resumeArgs": "-p --resume <id> (+ CLAUDE_CODE_RESUME_INTERRUPTED_TURN=1); never --session-id with --resume"
    },
    {
      "driver": "codex",
      "displayName": "Codex CLI",
      "binary": "codex",
      "versionProbe": ["--version"],
      "briefDelivery": "inline",
      "sessionCapture": "log",
      "sessionKeys": ["thread_id", "thread.started"],
      "resume": true,
      "capabilities": { "jsonLog": true, "preassign": false, "compactionHook": "verified", "autoModes": ["approval-policy driven"] },
      "permissionMap": { "supervised": "default approval_policy", "autoEdits": "acceptEdits-class where supported", "auto": "--auto equivalent", "full": "--auto --i-understand-danger" },
      "spawnArgs": "exec --json <parent opts> \"<brief inline>\"",
      "resumeArgs": "exec <parent opts> resume <id> \"<catchup inline>\""
    },
    {
      "driver": "grok",
      "displayName": "grok-build",
      "binary": "grok",
      "versionProbe": ["--version"],
      "briefDelivery": "file",
      "sessionCapture": "preassigned",
      "sessionKeys": ["session_id"],
      "resume": true,
      "capabilities": { "jsonLog": true, "preassign": true, "preassignFlag": "-s", "compactionHook": "verified", "autoModes": ["--always-approve", "acceptEdits middle ground"] },
      "permissionMap": { "supervised": "default prompts (no auto-accept-edits offered)", "autoEdits": "not offered — supervised + note", "auto": "--always-approve or acceptEdits", "full": "--always-approve --i-understand-danger" },
      "spawnArgs": "--prompt-file <brief> -s <uuid> --output-format json",
      "resumeArgs": "--prompt-file <catchup> -r <id>"
    },
    {
      "driver": "antigravity",
      "displayName": "Antigravity",
      "binary": "agy",
      "versionProbe": ["--version"],
      "briefDelivery": "inline",
      "sessionCapture": "none",
      "sessionKeys": [],
      "resume": false,
      "resumeNote": "no stable conversation id on stdout; honestly unsupported until vendor emits one",
      "capabilities": { "jsonLog": false, "preassign": false, "compactionHook": "verified", "autoModes": ["--dangerously-skip-permissions"] },
      "permissionMap": { "supervised": "default --mode accept-edits + native approvals", "autoEdits": "--mode accept-edits", "auto": "--dangerously-skip-permissions (native approvals can still surface)", "full": "--dangerously-skip-permissions --i-understand-danger" },
      "spawnArgs": "--print --mode accept-edits \"<brief inline>\"",
      "resumeArgs": "-p \"<catchup>\" --conversation <id> (id rarely captured)"
    },
    {
      "driver": "cursor",
      "displayName": "Cursor",
      "binary": "cursor-agent",
      "versionProbe": ["--version"],
      "briefDelivery": "inline",
      "sessionCapture": "none",
      "sessionKeys": [],
      "resume": false,
      "resumeNote": "id lives in stream-json; spawn uses plain print mode; honestly unsupported",
      "capabilities": { "jsonLog": false, "preassign": false, "compactionHook": "verified", "autoModes": ["--yolo"] },
      "permissionMap": { "supervised": "default prompts", "autoEdits": "not offered — supervised + note", "auto": "--auto adds --yolo", "full": "--yolo --i-understand-danger" },
      "spawnArgs": "cursor-agent -p --force --trust \"<brief inline>\"",
      "resumeArgs": "-p --force --resume <id> \"<catchup>\" (id rarely captured)"
    },
    {
      "driver": "generic",
      "displayName": "generic",
      "binary": null,
      "binaryNote": "operator-supplied --cmd; remote needs --allow-cmd",
      "versionProbe": [],
      "briefDelivery": "file",
      "briefNote": "prompt file path available; command decides how to consume it",
      "sessionCapture": "none",
      "sessionKeys": [],
      "resume": false,
      "resumeNote": "no continuity — fresh boot of the catch-up brief",
      "capabilities": { "jsonLog": false, "preassign": false, "compactionHook": "none", "autoModes": [] },
      "permissionMap": { "supervised": "command default", "autoEdits": "n/a", "auto": "operator --cmd decides", "full": "operator --cmd decides" },
      "spawnArgs": "--cmd \"<arbitrary>\"",
      "resumeArgs": "fresh boot only"
    }
  ]
}
