{
  "name": "@eamonpluto/agentboard",
  "version": "6.0.0",
  "description": "Zero-dependency message bus for AI coding-agent crews: message another agent, inserted into context, just a tool call.",
  "type": "module",
  "bin": {
    "agentboard": "bin/agentboard.js",
    "agentboard-mcp": "bin/agentboard-mcp.js",
    "agentboard-hook": "bin/agentboard-hook.js"
  },
  "scripts": {
    "test": "node test/agentboard.smoke.mjs && node test/agentboard.harness.mjs && node test/fault-injection.mjs && node test/integration.mjs",
    "bench": "node test/bench.mjs",
    "bench:load": "node test/load.mjs"
  },
  "files": [
    "bin/",
    "opencode/",
    "docs/",
    "examples/",
    "AGENTS.template.md",
    "TEAM.template.md",
    "documentation.html",
    "index.html",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "eamonpluto",
  "repository": {
    "type": "git",
    "url": "https://github.com/eamonpluto/agentboard.git"
  },
  "bugs": {
    "url": "https://github.com/eamonpluto/agentboard/issues"
  },
  "homepage": "https://eamonpluto.github.io/agentboard/"
}
