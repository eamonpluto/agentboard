{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "CrewBus M4 spike: loopback-only grant. Shell may spawn ONLY the bundled node sidecar (externalBin binaries/node) or the system-PATH node fallback, and ONLY to run the crewbus core (serve --port 0); http fetch ONLY to 127.0.0.1/localhost; no fs scope; no remote capability whatsoever.",
  "windows": ["main", "pair"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "node",
          "cmd": "node",
          "args": [{ "validator": "crewbus\\.js$" }, "serve", "--port", "0"]
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "node-fallback",
          "cmd": "node",
          "args": [{ "validator": "crewbus\\.js$" }, "serve", "--port", "0"]
        }
      ]
    },
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "http://127.0.0.1:*" }, { "url": "http://localhost:*" }]
    }
  ]
}
