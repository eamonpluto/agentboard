<?xml version="1.0" encoding="UTF-16"?>
<!--
  CrewBus desktop — Windows logon task (Task Scheduler import format).
  Single sidecar guarantee comes from the Tauri single-instance plugin
  (planned, see src-tauri/src/main.rs); until it lands, this task has NO
  "already running" guard — do not also enable autostart in the app.
  Adjust the exe path if you installed per-machine instead of per-user.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>CrewBus desktop: loopback sidecar + local dashboard shell. Starts at logon; board state untouched.</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>%LOCALAPPDATA%\CrewBus\CrewBus.exe</Command>
    </Exec>
  </Actions>
</Task>
